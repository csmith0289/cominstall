# Copy to .env.local for local overrides. Real values live in Netlify only, never in the repo.

# Postgres connection string (Neon in production, ending in ?sslmode=require). When unset, a local PGlite database is used.
# The Netlify build also runs the migrations against it (pnpm vercel-build).
DATABASE_URL=

# Folder for the local PGlite database, used only when DATABASE_URL is unset.
PGLITE_DIR=.data/pglite

# Required in production: a long random string, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The site's public URL, e.g. https://cominstall-jobcards.netlify.app. Links in emails start with it.
BETTER_AUTH_URL=http://localhost:3000

# Email (invitations, password reset, "Confirm your email") goes through Resend when both are set.
# When either is empty, each email is written to the server log and to EMAIL_OUTBOX_DIR instead, and nothing is sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Com-Install Job Cards <jobcards@com-install.co.uk>
EMAIL_FROM=
EMAIL_OUTBOX_DIR=.data/outbox

# Admins: comma-separated emails that become Admins when their account is created. Used to set up the first Admin
# (Luke Smith); after that, Admins invite everyone else from the app. Unset means nobody is made Admin this way.
ADMIN_EMAILS=

# The Operator (the app's developer, for support): comma-separated sign-in emails that may open /operator, once the
# email is confirmed. Everyone else gets a 404 there. It can't be granted or removed from inside the app. Unset means nobody.
OPERATOR_EMAILS=
