{
  "name": "cominstall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "vercel-build": "pnpm db:migrate && next build",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "jpeg-js": "^0.4.4",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
